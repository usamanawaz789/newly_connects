# SMTP settings for the contact form (api/contact.js).
# On Vercel: Project > Settings > Environment Variables.
# Locally with `vercel dev`: copy this file to .env.local and fill it in.

# Your mail provider's SMTP server, e.g. smtp.gmail.com, smtp.office365.com, smtp.zoho.com
SMTP_HOST=
# 465 (SSL) or 587 (STARTTLS)
SMTP_PORT=465
# Usually the full mailbox address
SMTP_USER=contact@newlyconnects.com
# Mailbox password or app password
SMTP_PASS=

# Optional: where inquiries are delivered (default contact@newlyconnects.com)
CONTACT_EMAIL=contact@newlyconnects.com
# Optional: sender address for both emails (default SMTP_USER)
MAIL_FROM=contact@newlyconnects.com
